# ==============================================================================
# TraceLens Configuration & Secrets Environment Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon / SQLite)
# ------------------------------------------------------------------------------
# Local Docker: postgresql+asyncpg://tracelens:tracelens_secret_pw@localhost:5432/tracelens
# Cloud Neon:  postgresql+asyncpg://<user>:<password>@<neon-host>.neon.tech/tracelens?ssl=require
# Local SQLite Dev fallback: sqlite+aiosqlite:///tracelens_dev.db
DATABASE_URL=postgresql+asyncpg://tracelens:tracelens_secret_pw@localhost:5432/tracelens

# ------------------------------------------------------------------------------
# 2. REDIS BUFFER (Redis 7 / Upstash)
# ------------------------------------------------------------------------------
# Local Docker: redis://localhost:6379/0
# Cloud Upstash: rediss://default:<password>@<upstash-endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
REDIS_INGEST_KEY=tracelens:ingest:queue

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_cryptographic_key_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. NETWORKING & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web dashboard origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tracelens.vercel.app

# ------------------------------------------------------------------------------
# 5. DASHBOARD FRONTEND (Next.js)
# ------------------------------------------------------------------------------
# Base API URL consumed by the browser client
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. TRACELENS PYTHON SDK CLIENT
# ------------------------------------------------------------------------------
# Used by applications instrumenting calls via tracelens.init()
TRACELENS_ENDPOINT=http://localhost:8000
TRACELENS_API_KEY=tl_live_your_project_api_key_here

# ------------------------------------------------------------------------------
# 7. OPTIONAL LLM EVALUATORS & ALERT INTEGRATIONS
# ------------------------------------------------------------------------------
# Evaluator LLM providers (for LLM-as-judge scoring)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Team Notifications (Slack-compatible webhook incoming URL)
SLACK_WEBHOOK_URL=
